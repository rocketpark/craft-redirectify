{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "404 Statistics" %}
{% set selectedSubnavItem = "stats" %}

{% block content %}
    {% if stats|length %}
        <table id="stats" class="data fullwidth collapsible">
            <thead>
                <tr>
                    <th scope="col">Requested URL</th>
                    <th scope="col">Hits</th>
                    <th scope="col">Last Hit</th>
                    <th scope="col">Referrer</th>
                    <th scope="col">Handled</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                {% for stat in stats %}
                    <tr data-id="{{ stat.id }}">
                        <td>
                            <code>{{ stat.requestedUrl }}</code>
                        </td>
                        <td>
                            <span class="status {{ stat.hitCount > 10 ? 'red' : (stat.hitCount > 5 ? 'orange' : 'green') }}"></span>
                            {{ stat.hitCount }}
                        </td>
                        <td>
                            {% if stat.lastHit %}
                                {{ stat.lastHit|date('M j, Y g:i a') }}
                            {% else %}
                                <span class="light">Unknown</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if stat.referrer %}
                                <a href="{{ stat.referrer }}" target="_blank" rel="noopener">{{ stat.referrer|truncate(40) }}</a>
                            {% else %}
                                <span class="light">Direct</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="status {{ stat.handled ? 'enabled' : 'disabled' }}"></span>
                            {{ stat.handled ? 'Yes' : 'No' }}
                        </td>
                        <td class="thin action">
                            {% if not stat.handled %}
                                <button class="btn small" onclick="openCreateRedirectModal({{ stat.id }}, '{{ stat.requestedUrl|e('js') }}')">+ Create Redirect</button>
                            {% endif %}
                            <button class="btn small" onclick="deleteStats({{ stat.id }})">Delete</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {# Modal for creating redirect from 404 #}
        <div id="create-redirect-modal" class="modal" style="display: none;">
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('redirectify/stats/create-redirect') }}
                <input type="hidden" name="statsId" id="modal-stats-id" value="">
                
                <div class="body">
                    <h2>Create Redirect</h2>
                    <p>Create a redirect for: <code id="modal-source-url"></code></p>
                    
                    {{ forms.textField({
                        label: "Destination URL"|t('redirectify'),
                        instructions: "Where should this URL redirect to?"|t('redirectify'),
                        id: 'modal-destination-url',
                        name: 'destinationUrl',
                        required: true,
                    }) }}
                </div>

                <div class="footer">
                    <div class="buttons right">
                        <button type="button" class="btn" onclick="closeCreateRedirectModal()">Cancel</button>
                        <button type="submit" class="btn submit">Create Redirect</button>
                    </div>
                </div>
            </form>
        </div>

        {% js %}
            function openCreateRedirectModal(statsId, sourceUrl) {
                document.getElementById('modal-stats-id').value = statsId;
                document.getElementById('modal-source-url').textContent = sourceUrl;
                document.getElementById('modal-destination-url').value = '';
                
                var modal = new Garnish.Modal($('#create-redirect-modal'));
            }

            function closeCreateRedirectModal() {
                // Modal will close automatically when clicking cancel
                location.reload();
            }

            function deleteStats(id) {
                if (confirm('Are you sure you want to delete this entry?')) {
                    Craft.sendActionRequest('POST', 'redirectify/stats/delete', {
                        data: { id: id }
                    }).then(function(response) {
                        if (response.data.success) {
                            location.reload();
                        } else {
                            Craft.cp.displayError('Could not delete entry.');
                        }
                    }).catch(function(error) {
                        Craft.cp.displayError('Could not delete entry.');
                    });
                }
            }
        {% endjs %}
    {% else %}
        <p>No 404 errors have been recorded yet. This is a good thing!</p>
    {% endif %}
{% endblock %}
